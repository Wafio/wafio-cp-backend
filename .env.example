# WAFio environment variables — override opsional untuk config/config.yaml
#
# Prefix WAFIO_; garis bawah untuk kunci bersarang: server.http_addr -> WAFIO_SERVER_HTTP_ADDR
# Urutan pemuatan: config/config.yaml -> env WAFIO_* -> flag CLI. Yang belakangan menang.
#
# Diselaraskan dengan internal/config/config.go pada 2026-08-24. Setiap kunci di bawah
# benar-benar dibaca kode; kunci mati sudah dibuang (lihat catatan di akhir berkas).

# ── Server — HTTP dan gRPC ──────────────────────────────────────
WAFIO_SERVER_HTTP_ADDR=
WAFIO_SERVER_AGENT_GRPC_ADDR=
WAFIO_SERVER_GRPC_DOMAIN=
WAFIO_SERVER_BASE_URL=
WAFIO_SERVER_ENV=
WAFIO_SERVER_FRONTEND_PATH=

# ── Server — CORS (matikan di produksi single-origin) ───────────
WAFIO_SERVER_CORS_ALLOW_CREDENTIALS=
WAFIO_SERVER_CORS_ALLOW_HEADERS=
WAFIO_SERVER_CORS_ALLOW_METHODS=
WAFIO_SERVER_CORS_ALLOW_ORIGINS=
WAFIO_SERVER_CORS_ENABLED=
WAFIO_SERVER_CORS_EXPOSE_HEADERS=
WAFIO_SERVER_CORS_MAX_AGE_SEC=

# ── Server — header keamanan ────────────────────────────────────
WAFIO_SERVER_SECURITY_HEADERS_ENABLED=

# ── Server — kunci login ────────────────────────────────────────
WAFIO_SERVER_LOGIN_MAX_ATTEMPTS=
WAFIO_SERVER_LOGIN_LOCK_MINUTES=

# ── Server — pembatas laju (8 kelompok independen) ──────────────
WAFIO_SERVER_RATE_LIMIT_AGENT_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_AGENT_MAX=
WAFIO_SERVER_RATE_LIMIT_AUTH_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_AUTH_MAX=
WAFIO_SERVER_RATE_LIMIT_ENABLED=
WAFIO_SERVER_RATE_LIMIT_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_LOGIN_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_LOGIN_MAX=
WAFIO_SERVER_RATE_LIMIT_MAX=
WAFIO_SERVER_RATE_LIMIT_OTP_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_OTP_MAX=
WAFIO_SERVER_RATE_LIMIT_READ_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_READ_MAX=
WAFIO_SERVER_RATE_LIMIT_REGISTER_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_REGISTER_MAX=
WAFIO_SERVER_RATE_LIMIT_RENEW_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_RENEW_MAX=
WAFIO_SERVER_RATE_LIMIT_WRITE_EXPIRATION_SEC=
WAFIO_SERVER_RATE_LIMIT_WRITE_MAX=

# ── Database (wajib di produksi) ────────────────────────────────
WAFIO_DATABASE_HOST=
WAFIO_DATABASE_PORT=
WAFIO_DATABASE_NAME=
WAFIO_DATABASE_USER=
WAFIO_DATABASE_PASSWORD=
WAFIO_DATABASE_SSLMODE=
# Ukuran pool pgx bersama. Satu pool melayani ingest keputusan, query dashboard,
# auth, serta jalur eBPF dan host sekaligus. Default pgx sendiri, max(4, NumCPU),
# membuat lonjakan trafik WAF membuat dashboard kelaparan koneksi.
# Jaga total seluruh proses yang menunjuk database ini di bawah max_connections
# server (bawaan 100).
WAFIO_DATABASE_MAX_CONNS=
WAFIO_DATABASE_MIN_CONNS=

# ── JWT (wajib; ganti secret di produksi) ───────────────────────
# WAJIB diganti. Nilai bawaan ini publik dan kini DITOLAK saat boot.
#   openssl rand -hex 32
WAFIO_JWT_SECRET=
WAFIO_JWT_EXPIRE_HOURS=

# ── TOTP — enkripsi rahasia 2FA saat disimpan ───────────────────
# WAJIB. Server menolak boot tanpa ini. 32 byte = 64 hex, hasilkan dengan:
#   openssl rand -hex 32
WAFIO_TOTP_ENC_KEY=

# ── GeoIP MaxMind ───────────────────────────────────────────────
WAFIO_GEO_COUNTRY_DB_PATH=
WAFIO_GEO_CITY_DB_PATH=
WAFIO_GEO_ASN_DB_PATH=
WAFIO_GEO_MAXMIND_LICENSE_KEY=

# ── mTLS untuk agent gRPC ───────────────────────────────────────
WAFIO_MTLS_CERT_VALIDITY_DAYS=
WAFIO_MTLS_CERT_WARN_BEFORE_DAYS=
WAFIO_MTLS_CERTS_DIR=
WAFIO_MTLS_SERVER_CERT_AUTO_RENEW=
WAFIO_MTLS_SERVER_CERT_RENEW_BEFORE_DAYS=

# ── SMTP untuk OTP dan undangan ─────────────────────────────────
WAFIO_SMTP_ENCRYPTION=
WAFIO_SMTP_FROM=
WAFIO_SMTP_HOST=
WAFIO_SMTP_OTP_EXPIRY_MIN=
WAFIO_SMTP_PASSWORD=
WAFIO_SMTP_PORT=
WAFIO_SMTP_USERNAME=

# ── Bot protection — daftar default ─────────────────────────────
# WAFIO_BOT_DEFAULTS_JA3_BLACKLIST_FILE=
WAFIO_BOT_DEFAULTS_UA_BAD_BOT_FILE=

# ── Dashboard ───────────────────────────────────────────────────
WAFIO_LOGS_CACHE_TTL_SEC=

# ── Alias env lama yang MASIH didukung ────────────────────────────
# WAFIO_TLS_GEN_CLIENT_DIR -> WAFIO_MTLS_CERTS_DIR

# ── Kunci yang DIHAPUS (2026-08-24) ───────────────────────────────
# Tidak dibaca kode mana pun. Menyetelnya tidak berpengaruh. Hapus juga dari .env lokal.
#
#   WAFIO_SERVER_TCP_MTLS_ADDR, WAFIO_SERVER_TCP_FRAME_READ_TIMEOUT_SEC, WAFIO_TCP_ADDR
#       transport TCP mTLS :9089 dihapus dari kode
#   WAFIO_MANTICORE_URL, WAFIO_MANTICORE_INDEX,
#   WAFIO_DASHBOARD_MANTICORE_URL, WAFIO_DASHBOARD_MANTICORE_INDEX
#       Manticore dihapus seluruhnya
#   WAFIO_GEOIP_DB_PATH, WAFIO_GEOIP_CITY_DB_PATH, WAFIO_GEOIP_ASN_DB_PATH
#       alias lama; pakai WAFIO_GEO_COUNTRY_DB_PATH / _CITY_ / _ASN_
#   WAFIO_LIMITS_*
#       LimitsConfig adalah struct kosong
#   WAFIO_LICENSE_KEY_FILE, WAFIO_LIMITS_*
#       LicenseConfig dan LimitsConfig sudah dihapus dari kode
#   WAFIO_CRS_SETUP_FILE, WAFIO_CRS_RULES_GLOB, WAFIO_CRS_DIR
#       rule set v1 tidak ada lagi; agent WAF hanya memakai mesin semantik
#   WAFIO_CRS_DEFAULT_DIR
#       diganti WAFIO_SECURITY_DATA_DIR, variabel agent WAF (direktori data keamanan itu sendiri);
#       control plane tidak membaca keduanya

# ── Catatan bootstrap ─────────────────────────────────────────────
# Wizard setup berbasis browser sudah dihapus. Instalasi pertama:
#
#   wafio migrate up
#   wafio admin create --email you@example.com --name "Your Name"
#
# Installer control plane (install-controlplane.sh di wafio-release) menjalankan keduanya dan membangkitkan
# jwt.secret serta totp.enc_key untuk Anda.
